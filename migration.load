LOAD DATABASE
    FROM mysql://root@host.docker.internal/gaming_store
    INTO postgresql://postgres:postgres@host.docker.internal/gaming_store

WITH include drop,
     create tables,
     create indexes,
     reset sequences,
     foreign keys

CAST
    type datetime to timestamptz drop default drop not null,
    type date to date

ALTER SCHEMA 'gaming_store' RENAME TO 'public';